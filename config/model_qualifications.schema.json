{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exculpata.example/model-qualifications.schema.json",
  "title": "Recorded claim-evaluation qualifications",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "qualifications"],
  "properties": {
    "schema_version": {"const": 1},
    "qualifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model_id", "harness", "passed"],
        "properties": {
          "model_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "harness": {"type": "string", "minLength": 1, "maxLength": 80},
          "passed": {"type": "boolean"},
          "evidence": {"type": "string", "maxLength": 200}
        }
      }
    }
  }
}
