# EXCULPATA_* names are preferred; matching RECORDBENCH_* names remain supported but deprecated.
CASE_INTELLIGENCE_AUTH_MODE=kerberos
CASE_INTELLIGENCE_SECURE_COOKIE=1
CASE_INTELLIGENCE_KERBEROS_REALM=EXAMPLE.TEST
CASE_INTELLIGENCE_KERBEROS_ALLOWED_GROUPS=recordbench_users@example.test
CASE_INTELLIGENCE_KERBEROS_ADMIN_GROUPS=recordbench_administrators@example.test
CASE_INTELLIGENCE_KERBEROS_ALLOWED_PRINCIPALS=
CASE_INTELLIGENCE_KERBEROS_ADMIN_PRINCIPALS=
CASE_INTELLIGENCE_KERBEROS_PROXY_SECRET_FILE=/run/recordbench-secrets/kerberos-proxy-secret
