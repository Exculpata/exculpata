# EXCULPATA_* names are preferred; matching RECORDBENCH_* names remain supported but deprecated.
CASE_INTELLIGENCE_AUTH_MODE=oidc
CASE_INTELLIGENCE_SECURE_COOKIE=1
CASE_INTELLIGENCE_EXTERNAL_ORIGIN=https://recordbench.example.test
CASE_INTELLIGENCE_OIDC_ISSUER=https://identity.example.test/realms/case-team
CASE_INTELLIGENCE_OIDC_CLIENT_ID=recordbench
CASE_INTELLIGENCE_OIDC_CLIENT_SECRET_FILE=/run/recordbench-secrets/oidc-client-secret
CASE_INTELLIGENCE_OIDC_SCOPES=openid profile email
CASE_INTELLIGENCE_OIDC_ALLOWED_GROUPS=RecordBench_Users
CASE_INTELLIGENCE_OIDC_ADMIN_GROUPS=RecordBench_Administrators
CASE_INTELLIGENCE_OIDC_GROUPS_CLAIM=groups
CASE_INTELLIGENCE_OIDC_DISPLAY_NAME_CLAIM=name
CASE_INTELLIGENCE_OIDC_LOGIN_NAME_CLAIM=preferred_username
CASE_INTELLIGENCE_OIDC_TOKEN_AUTH_METHOD=client_secret_post
# CASE_INTELLIGENCE_OIDC_CA_FILE=/run/recordbench-secrets/organization-ca.pem
