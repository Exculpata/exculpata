.git
.gitignore
.venv
.tmp
__pycache__
*.pyc
.pytest_cache
artifacts
docs
tests
benchmarks
services/transcription/tests
services/transcription/docs
services/transcription/data

# Local configuration, identity material, and credentials never enter a build context.
.env
.env.*
**/.env
**/.env.*
**/secrets
**/secrets/**
**/certs
**/certs/**
**/*.cer
**/*.crt
**/*.der
**/*.jks
**/*.key
**/*.keytab
**/*.keystore
**/*.p12
**/*.pfx
**/*.pem

# Runtime state, operator output, backups, and transfer archives stay host-side.
**/*.db
**/*.log
**/*.sqlite
**/*.sqlite3
**/*.7z
**/*.gz
**/*.rar
**/*.tar
**/*.tgz
**/*.zip
**/backups
**/backups/**
**/recordbench-node
**/recordbench-node/**
**/exculpata-node
**/exculpata-node/**
**/runtime
**/runtime/**
**/state
**/state/**
