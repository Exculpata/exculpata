# EXCULPATA_* names are preferred; matching RECORDBENCH_* names remain supported but deprecated.
# Compose topology. Copy to .env through ./install and keep it private.
EXCULPATA_COMPOSE_PROJECT=recordbench
# Deprecated alias: RECORDBENCH_COMPOSE_PROJECT
EXCULPATA_IMAGE_NAMESPACE=recordbench
# Deprecated alias: RECORDBENCH_IMAGE_NAMESPACE
EXCULPATA_RELEASE_ID=dev
# Deprecated alias: RECORDBENCH_RELEASE_ID
EXCULPATA_UID=1000
# Deprecated alias: RECORDBENCH_UID
EXCULPATA_GID=1000
# Deprecated alias: RECORDBENCH_GID

# Host paths may live on local storage or a host-mounted NAS. Do not use a
# broad directory or the root of a share.
EXCULPATA_CONFIG_ROOT=/srv/recordbench/config
# Deprecated alias: RECORDBENCH_CONFIG_ROOT
EXCULPATA_SECRETS_ROOT=/srv/recordbench/secrets
# Deprecated alias: RECORDBENCH_SECRETS_ROOT
EXCULPATA_RUNTIME_ROOT=/srv/recordbench/runtime
# Deprecated alias: RECORDBENCH_RUNTIME_ROOT
EXCULPATA_STORAGE_ROOT=/srv/recordbench/matter-storage
# Deprecated alias: RECORDBENCH_STORAGE_ROOT
EXCULPATA_TRANSCRIPTION_ROOT=/srv/recordbench/transcription
# Deprecated alias: RECORDBENCH_TRANSCRIPTION_ROOT
EXCULPATA_STATE_ROOT=/srv/recordbench/state
# Deprecated alias: RECORDBENCH_STATE_ROOT
EXCULPATA_MODEL_ROOT=/srv/recordbench/models
# Deprecated alias: RECORDBENCH_MODEL_ROOT

# HTTPS is loopback-only until the operator deliberately selects a LAN bind.
EXCULPATA_BIND_ADDRESS=127.0.0.1
# Deprecated alias: RECORDBENCH_BIND_ADDRESS
EXCULPATA_HTTPS_PORT=8443
# Deprecated alias: RECORDBENCH_HTTPS_PORT
EXCULPATA_SERVER_NAME=recordbench.example.test
# Deprecated alias: RECORDBENCH_SERVER_NAME
EXCULPATA_TLS_CERT=/srv/recordbench/tls/tls.crt
# Deprecated alias: RECORDBENCH_TLS_CERT
EXCULPATA_TLS_KEY=/srv/recordbench/tls/tls.key
# Deprecated alias: RECORDBENCH_TLS_KEY
EXCULPATA_GATEWAY_UPSTREAM=app:8786
# Deprecated alias: RECORDBENCH_GATEWAY_UPSTREAM

# Portable one-GPU assignment. Learned embedding and reranking default to CPU;
# generation and transcription are co-resident on GPU 0 with conservative
# memory limits. There is no cross-service GPU scheduler: validate this shape
# on the exact card before staff use. Automatic installation separates services
# when more devices are available.
EXCULPATA_GENERATOR_GPU=0
# Deprecated alias: RECORDBENCH_GENERATOR_GPU
EXCULPATA_GENERATOR_TENSOR_PARALLEL=1
# Deprecated alias: RECORDBENCH_GENERATOR_TENSOR_PARALLEL
EXCULPATA_RETRIEVAL_GPU=0
# Deprecated alias: RECORDBENCH_RETRIEVAL_GPU
EXCULPATA_TRANSCRIPTION_GPU=0
# Deprecated alias: RECORDBENCH_TRANSCRIPTION_GPU
EXCULPATA_RETRIEVAL_DEVICE=cpu
# Deprecated alias: RECORDBENCH_RETRIEVAL_DEVICE

# Pinned default model portfolio. Change only through a reviewed model profile.
EXCULPATA_GENERATOR_MODEL_ID=Qwen/Qwen3.5-4B
# Deprecated alias: RECORDBENCH_GENERATOR_MODEL_ID
EXCULPATA_GENERATOR_REVISION=851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a
# Deprecated alias: RECORDBENCH_GENERATOR_REVISION
EXCULPATA_GENERATOR_SERVED_NAME=recordbench-qwen35-4b
# Deprecated alias: RECORDBENCH_GENERATOR_SERVED_NAME
EXCULPATA_GENERATOR_DTYPE=bfloat16
# Deprecated alias: RECORDBENCH_GENERATOR_DTYPE
EXCULPATA_GENERATOR_CONTEXT=16384
# Deprecated alias: RECORDBENCH_GENERATOR_CONTEXT
EXCULPATA_GENERATOR_SEQUENCES=4
# Deprecated alias: RECORDBENCH_GENERATOR_SEQUENCES
EXCULPATA_GENERATOR_GPU_UTILIZATION=0.50
# Deprecated alias: RECORDBENCH_GENERATOR_GPU_UTILIZATION
EXCULPATA_EMBEDDING_MODEL=ibm-granite/granite-embedding-english-r2
# Deprecated alias: RECORDBENCH_EMBEDDING_MODEL
EXCULPATA_EMBEDDING_REVISION=47ea694b257b703fee9253d75c2b1f2985180498
# Deprecated alias: RECORDBENCH_EMBEDDING_REVISION
EXCULPATA_RERANKER_MODEL=Alibaba-NLP/gte-reranker-modernbert-base
# Deprecated alias: RECORDBENCH_RERANKER_MODEL
EXCULPATA_RERANKER_REVISION=f7481e6055501a30fb19d090657df9ec1f79ab2c
# Deprecated alias: RECORDBENCH_RERANKER_REVISION
