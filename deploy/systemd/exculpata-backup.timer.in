[Unit]
Description=Quiet-hour Exculpata backup with one retry (@NODE_ID@)
Documentation=file:@RELEASE_ROOT@/docs/STORAGE_AND_BACKUP.md

[Timer]
OnCalendar=*-*-* 03:15:00
OnCalendar=*-*-* 05:15:00
RandomizedDelaySec=10m
Persistent=true
Unit=exculpata-backup-@NODE_ID@.service

[Install]
WantedBy=timers.target
