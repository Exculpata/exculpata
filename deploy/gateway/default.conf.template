# Content-free request accounting also covers rejected and failed requests.
# Paths can contain matter names; request-context error diagnostics include queries.
log_format exculpata_safe 'gateway time=$time_iso8601 status=$status '
                         'bytes=$body_bytes_sent duration=$request_time';
error_log /dev/null;

limit_req_zone $binary_remote_addr zone=recordbench_login:10m rate=10r/m;

server {
    access_log /dev/stdout exculpata_safe;
    listen 8443 ssl;
    server_name ${EXCULPATA_SERVER_NAME};

    ssl_certificate /run/tls/tls.crt;
    ssl_certificate_key /run/tls/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    server_tokens off;
    client_max_body_size 101g;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    location = /auth/local {
        limit_req zone=recordbench_login burst=5 nodelay;
        proxy_pass http://${EXCULPATA_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Exculpata-Authenticated-User "";
        proxy_set_header X-Exculpata-Proxy-Secret "";
        proxy_set_header X-Exculpata-Auth-Diagnostic "";
        proxy_set_header X-RecordBench-Authenticated-User "";
        proxy_set_header X-RecordBench-Proxy-Secret "";
        proxy_set_header X-RecordBench-Auth-Diagnostic "";
    }

    location / {
        proxy_pass http://${EXCULPATA_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Exculpata-Authenticated-User "";
        proxy_set_header X-Exculpata-Proxy-Secret "";
        proxy_set_header X-Exculpata-Auth-Diagnostic "";
        proxy_set_header X-RecordBench-Authenticated-User "";
        proxy_set_header X-RecordBench-Proxy-Secret "";
        proxy_set_header X-RecordBench-Auth-Diagnostic "";
        proxy_set_header Authorization $http_authorization;
    }
}
